# Copier en .env.local et remplir. Ne jamais commiter .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Tâches serveur uniquement (collecte, analyse, agent). Jamais côté navigateur.
SUPABASE_SECRET_KEY=sb_secret_...
GEMINI_API_KEY=
# Taille du marché (portail-api.insee.fr, API Sirene, plan public)
INSEE_API_KEY=
# Recherche web de l'agent (tavily.com, offre gratuite)
TAVILY_API_KEY=tvly-...
# Code demandé pour lancer une enquête (obligatoire en ligne, facultatif en local)
RADAR_CODE_ACCES=
# En ligne seulement : jeton GitHub limité à ce dépôt (droit « Actions : écriture ») pour lancer l'agent
GITHUB_DISPATCH_TOKEN=
